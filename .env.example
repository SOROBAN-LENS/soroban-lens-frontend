# SorobanLens frontend configuration.
# Copy to `.env.local` (git-ignored) and adjust. Every variable prefixed with
# VITE_ is embedded into the client bundle at build time, so NEVER put secrets
# here — the frontend has no secrets; authentication (if any) belongs to the backend.

# Base URL of the soroban-lens-backend API, without a trailing slash.
# Leave empty to call the same origin the app is served from (recommended for
# local development, where Vite proxies /api and /health to VITE_DEV_PROXY_TARGET).
# Example for a deployed backend: https://api.sorobanlens.example
VITE_API_BASE_URL=

# Dev-server only: where Vite forwards /api/* and /health requests.
VITE_DEV_PROXY_TARGET=http://localhost:8080

# Default Stellar network preselected in the analyzer: testnet | mainnet
VITE_DEFAULT_NETWORK=testnet

# Client-side request timeout in milliseconds.
VITE_REQUEST_TIMEOUT_MS=30000
